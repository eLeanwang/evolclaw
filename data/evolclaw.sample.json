{
  "agents": {
    "anthropic": {
      "model": "sonnet"
    },
    "openai": {
      "apiKey": "your-openai-api-key",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-5.2-codex",
      "effort": "medium"
    },
    "google": {
      "model": "gemini-2.5-flash"
    },
    "defaultAgent": "claude"
  },
  "channels": {
    "defaultChannel": "feishu",
    "feishu": {
      "enabled": true,
      "appId": "",
      "appSecret": ""
    },
    "wechat": {
      "enabled": false,
      "baseUrl": "https://ilinkai.weixin.qq.com",
      "token": ""
    },
    "aun": {
      "enabled": false,
      "aid": "your-agent.agentid.pub",
      "gatewayPort": 443
    }
  },
  "projects": {
    "defaultPath": "/path/to/default/project",
    "autoCreate": true,
    "list": {}
  },
  "idleMonitor": {
    "enabled": true,
    "timeout": 120,
    "safeModeThreshold": 3
  },
  "flushDelay": 4,
  "showActivities": "all"
}
