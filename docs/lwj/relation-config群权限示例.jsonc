{
  // 规范类型：Relation 级群配置示例
  // 目标路径：{evolclaw_home}/agents/{aid}/relations/aun#grp-123/config.json
  //
  // roles.assigned：整个群默认角色。
  // roles.members：群内成员专属角色。
  // 这两个字段是目标权限体系扩展字段，落地时需要同步扩展 relation-config schema。

  "$schema_version": 1,

  "roles": {
    "assigned": "visitor",
    "members": {
      "alice.aid.pub": "member",
      "bob.aid.pub": "reviewer",
      "dev.aid.pub": "developer"
    }
  },

  "permissionMode": "readonly",
  "active_baseagent": "claude",
  "baseagents": {
    "claude": {
      "model": "claude-haiku-4-5-20251001",
      "effort": "low"
    }
  },
  "chatmode": {
    "group": "proactive"
  },
  "dispatch": "mention",
  "show_activities": "none",
  "flush_delay": 5,
  "debounce": 0,
  "enable_rich_content": false
}
