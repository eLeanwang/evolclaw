{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-config.schema.2.json",
  "title": "AgentConfig (agents/{aid}/config.json)",
  "description": "单 agent 的身份、凭证、管控字段。H 链中级，覆盖 defaults。",
  "x-logical-name": "agent-config",
  "x-permission": "H",
  "x-scope": "agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["aid", "channels"],
  "properties": {
    "$schema_version": { "type": "number", "default": 2, "x-merge": "scalar" },
    "aid": { "type": "string", "description": "Agent 标识（必填）", "x-merge": "scalar" },
    "enabled": { "type": "boolean", "description": "Agent 启用状态", "x-merge": "scalar" },
    "lifecycle": {
      "type": "string",
      "enum": ["created", "bootstrapping", "active"],
      "description": "Agent 生命周期状态：created → bootstrapping → active",
      "x-merge": "scalar"
    },
    "initialized": { "type": "boolean", "description": "Deprecated: AUN 首次初始化标记，仅兼容旧配置", "x-merge": "scalar" },
    "channels": {
      "type": "array",
      "items": { "type": "object" },
      "description": "渠道实例（含 appSecret/token，应为 ${VAR} 引用）",
      "x-merge": "list"
    },
    "aun": {
      "type": "object",
      "description": "该 agent 的 AUN 配置",
      "x-merge": "dict",
      "properties": {
        "keystorePath": { "type": "string" },
        "encryptionSeed": { "type": "string" },
        "gatewayUrl": { "type": "string" }
      }
    },
    "models": {
      "type": "object",
      "description": "模型白名单（覆盖 defaults）",
      "x-merge": "dict",
      "properties": {
        "default": { "type": "string" },
        "allowed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "active_baseagent": {
      "type": "string",
      "description": "当前活跃的 base agent（claude/codex/gemini）。暂存于此，待权限体系实现后迁移。",
      "x-merge": "scalar"
    },
    "baseagents": {
      "type": "object",
      "description": "各 base agent 配置（model/effort/apiKey/baseUrl 等）。暂存于此，待权限体系实现后迁移。",
      "x-merge": "dict"
    },
    "projects": {
      "type": "object",
      "description": "项目路径配置",
      "x-merge": "dict",
      "properties": {
        "defaultPath": { "type": "string", "description": "Agent 项目路径" }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "EvolClaw 层能力策略（baseagent → type → mode/overrides）",
      "x-merge": "dict",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["inherit", "all", "none"] },
              "overrides": {
                "type": "object",
                "additionalProperties": { "type": "string", "enum": ["enabled", "disabled"] }
              }
            }
          },
          "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["inherit", "all", "none"] },
              "overrides": {
                "type": "object",
                "additionalProperties": { "type": "string", "enum": ["enabled", "disabled"] }
              }
            }
          },
          "plugin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["inherit", "all", "none"] },
              "overrides": {
                "type": "object",
                "additionalProperties": { "type": "string", "enum": ["enabled", "disabled"] }
              }
            }
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "description": "调试配置",
      "x-merge": "dict",
      "properties": {
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"] },
        "flusherDiag": { "type": "boolean" },
        "aunTrace": { "type": "boolean" },
        "aunSdkLog": { "type": "boolean" },
        "upmsg": { "type": "boolean" }
      }
    },
    "observable": { "type": "boolean", "description": "观察者模式：入站/出站各转一份给 owner 角色对端", "x-merge": "scalar" },
    "chatmode": {
      "type": "object",
      "description": "聊天模式配置（private/group/nothuman）",
      "x-merge": "dict",
      "properties": {
        "private": { "type": "string", "enum": ["interactive", "proactive"], "description": "私聊模式" },
        "group": { "type": "string", "enum": ["interactive", "proactive"], "description": "群聊模式" },
        "nothuman": { "type": "string", "enum": ["interactive", "proactive"], "description": "无人类场景模式" }
      }
    },
    "response_modes": {
      "type": "object",
      "description": "响应模式配置（响应系统插件化）。default_private/default_group/configs/overrides 按第一层键合并",
      "x-merge": "dict",
      "properties": {
        "default_private": { "type": "string", "description": "单聊默认响应模式 id" },
        "default_group": { "type": "string", "description": "群聊默认响应模式 id" },
        "configs": { "type": "object", "description": "各模式配置参数（modeId → 配置对象）" },
        "overrides": { "type": "object", "description": "按对端/群覆盖（peerKey → {mode, config}）" }
      }
    },
    "flush_delay": {
      "type": "number",
      "description": "消息 flush 间隔（秒）",
      "x-merge": "scalar"
    },
    "debounce": {
      "type": "number",
      "description": "入站消息去抖间隔（秒）",
      "x-merge": "scalar"
    },
    "dispatch": {
      "type": "string",
      "enum": ["mention", "broadcast"],
      "description": "群聊分发策略：mention=仅@时响应, broadcast=广播响应",
      "x-merge": "scalar"
    },
    "show_activities": {
      "type": "string",
      "enum": ["all", "none"],
      "description": "中间活动可见性",
      "x-merge": "scalar"
    },
    "proactive": {
      "type": "object",
      "description": "Proactive 模式细粒度策略",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "pre_tool_1stmsgchk": {
          "type": "boolean",
          "description": "Proactive 下首次工具调用前必须先 send/file 表态"
        },
        "tool_use_reminder": {
          "type": "boolean",
          "description": "Proactive 下启用队列未读提醒和工具汇报提醒"
        }
      }
    },
    "render": {
      "type": "object",
      "description": "各渲染类型当前激活的 modeName",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "private": { "type": "string", "description": "私聊渲染模式名称" },
        "group": { "type": "string", "description": "群聊渲染模式名称" },
        "inject": { "type": "string", "description": "注入渲染模式名称" }
      }
    },
    "enable_rich_content": {
      "type": "boolean",
      "description": "启用富内容渲染",
      "x-merge": "scalar"
    },
    "permissionMode": {
      "type": "string",
      "description": "执行权限模式",
      "x-merge": "scalar"
    },
    "roles": {
      "type": "object",
      "description": "角色级行为覆盖：role → { baseagents, permissionMode }",
      "x-merge": "dict",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseagents": { "type": "object", "description": "角色级 baseagents 覆盖" },
          "permissionMode": { "type": "string", "description": "角色级 permissionMode 覆盖" }
        }
      }
    },
    "extra_backup": {
      "type": "array",
      "description": "快照额外备份文件声明（不得指向 .env）",
      "x-merge": "list",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "pattern": { "type": "string" }
        }
      }
    }
  }
}
