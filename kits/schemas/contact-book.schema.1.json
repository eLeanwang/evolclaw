{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contact-book.schema.1.json",
  "title": "ContactBook (agents/{aid}/contact.json)",
  "x-logical-name": "contact-book",
  "x-scope": "contact",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema_version": { "type": "number", "default": 1, "x-merge": "scalar" },
    "contacts": {
      "type": "object",
      "x-merge": "dict",
      "propertyNames": {
        "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\\.){2,}[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "displayName": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+:.+$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
