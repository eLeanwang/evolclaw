{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "defaults.schema.1.json",
  "title": "DefaultsConfig (agents/defaults.json)",
  "description": "全局默认配置。H 链最低层。",
  "x-logical-name": "defaults",
  "x-permission": "H",
  "x-scope": "defaults",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema_version": { "type": "number", "default": 1, "x-merge": "scalar" },
    "models": {
      "type": "object",
      "description": "模型配置",
      "x-merge": "dict",
      "properties": {
        "default": { "type": "string", "description": "全局默认模型" },
        "allowed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "全局模型白名单"
        }
      }
    },
    "active_baseagent": {
      "type": "string",
      "description": "当前活跃的 base agent（claude/codex/gemini）。暂存于此，待权限体系实现后迁移。",
      "x-merge": "scalar"
    },
    "baseagents": {
      "type": "object",
      "description": "各 base agent 配置（model/effort/apiKey/baseUrl 等）。暂存于此，待权限体系实现后迁移。",
      "x-merge": "dict"
    },
    "projects": {
      "type": "object",
      "description": "项目路径配置",
      "x-merge": "dict",
      "properties": {
        "rootPath": { "type": "string", "description": "全局项目根路径" },
        "defaultPath": { "type": "string", "description": "全局默认项目路径" }
      }
    },
    "aun": {
      "type": "object",
      "description": "全局 AUN 配置",
      "x-merge": "dict",
      "properties": {
        "keystorePath": { "type": "string" },
        "encryptionSeed": { "type": "string" },
        "gatewayUrl": { "type": "string" }
      }
    },
    "debug": {
      "type": "object",
      "description": "全局调试配置",
      "x-merge": "dict",
      "properties": {
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR"] },
        "flusherDiag": { "type": "boolean" },
        "aunTrace": { "type": "boolean" },
        "aunSdkLog": { "type": "boolean" },
        "upmsg": { "type": "boolean" }
      }
    },
    "group_venue_sync": {
      "type": "object",
      "description": "群资源空间同步到本地 venues 的全局默认策略（群规则 + 资源索引）",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "是否启用群资源空间同步，默认 true" },
        "rulesPath": { "type": "string", "description": "群空间内规则文件路径，默认 /announce/evolclaw/rules.md" },
        "indexPath": { "type": "string", "description": "群空间资源索引扫描根路径，默认 /" },
        "maxIndexItems": { "type": "number", "description": "注入资源索引最大条目数，默认 80" },
        "maxRulesBytes": { "type": "number", "description": "规则文件最大字节数，默认 65536" },
        "refreshIntervalMs": { "type": "number", "description": "两次远端 mtime 检查最小间隔，默认 60000ms" },
        "allowRemoteWrite": { "type": "boolean", "description": "预留：运行期同步不写远端，只有显式管理命令可使用" }
      }
    }
  }
}
