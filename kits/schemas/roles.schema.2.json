{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roles.schema.2.json",
  "title": "RolesConfig",
  "description": "Global role definitions and permissions",
  "x-logical-name": "roles",
  "x-permission": "H",
  "x-scope": "roles",
  "type": "object",
  "required": ["$schema_version", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema_version": {
      "type": "number",
      "const": 2,
      "description": "Schema version"
    },
    "defaultRole": {
      "type": "string",
      "default": "anonymous",
      "description": "Default role for unauthenticated users without an explicit role assignment"
    },
    "roles": {
      "type": "object",
      "description": "Role definitions keyed by role name",
      "additionalProperties": {
        "$ref": "#/definitions/RoleDefinition"
      }
    }
  },
  "definitions": {
    "RoleDefinition": {
      "type": "object",
      "required": ["description", "permissions"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable role description"
        },
        "allowAccess": {
          "type": "boolean",
          "default": true,
          "description": "Whether users with this role can access the agent (false = reject with permission denied)"
        },
        "permissions": {
          "type": "object",
          "description": "Field-level permissions",
          "additionalProperties": {
            "$ref": "#/definitions/FieldPermission"
          }
        }
      }
    },
    "FieldPermission": {
      "type": "object",
      "required": ["default", "allowOverride"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "Default value for this field (any type)"
        },
        "allowOverride": {
          "type": "boolean",
          "description": "Whether relation-level config can override this field"
        },
        "allowedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed model patterns for baseagents fields (e.g., ['claude-sonnet-*', 'claude-haiku-*'])"
        },
        "allowedValues": {
          "type": "array",
          "description": "Allowed values for enum-like fields"
        },
        "reason": {
          "type": "string",
          "description": "Explanation for this permission setting"
        }
      }
    }
  }
}
