{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-config.schema.3.json",
  "title": "AgentConfig (agents/{aid}/config.json)",
  "x-logical-name": "agent-config",
  "x-scope": "agent",
  "type": "object",
  "additionalProperties": true,
  "required": ["aid", "channels"],
  "properties": {
    "$schema_version": { "type": "number", "default": 3, "x-merge": "scalar" },
    "aid": { "type": "string", "x-merge": "scalar" },
    "enabled": { "type": "boolean", "x-merge": "scalar" },
    "lifecycle": { "type": "string", "enum": ["created", "bootstrapping", "active"], "x-merge": "scalar" },
    "initialized": { "type": "boolean", "x-merge": "scalar" },
    "owners": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "x-merge": "list"
    },
    "admins": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "x-merge": "list"
    },
    "channels": { "type": "array", "items": { "type": "object" }, "x-merge": "list" },
    "aun": { "type": "object", "x-merge": "dict" },
    "models": { "type": "object", "x-merge": "dict" },
    "active_baseagent": { "type": "string", "x-merge": "scalar" },
    "baseagents": { "type": "object", "x-merge": "dict" },
    "projects": { "type": "object", "x-merge": "dict" },
    "capabilities": { "type": "object", "x-merge": "dict" },
    "debug": { "type": "object", "x-merge": "dict" },
    "observable": { "type": "boolean", "x-merge": "scalar" },
    "chatmode": { "type": "object", "x-merge": "dict", "default": { "private": "interactive", "group": "proactive", "nothuman": "proactive" }, "properties": { "private": { "enum": ["interactive", "proactive"] }, "group": { "enum": ["interactive", "proactive"] }, "nothuman": { "enum": ["interactive", "proactive"] } }, "additionalProperties": false, "description": "chatMode 场景默认表；出厂默认值即此 default（agent 级改默认，关系级按键覆盖）。键封闭 private/group/nothuman，值枚举 interactive/proactive" },
    "mentionMode": { "type": "string", "enum": ["disabled", "mention-only"], "default": "disabled", "x-merge": "scalar", "description": "@ 处理策略（顶层通用参数）：disabled=处理所有消息；mention-only=只处理被 @ 的消息，未 @ 作引用上下文" },
    "model": { "type": "string", "x-merge": "scalar", "description": "主会话模型（顶层通用参数）；无默认值，缺省时由响应模式/全局默认决定" },
    "responseMode": { "type": "string", "x-merge": "scalar", "description": "响应模式 id（标量）；候选清单/默认值来自注册表，非 schema。关系级>agent级>注册表首选" },
    "responseModeParams": { "type": "object", "x-merge": "dict", "description": "响应模式特有参数字典，按模式 id 分桶：{ [modeId]: {...} }" },
    "flush_delay": { "type": "number", "x-merge": "scalar" },
    "debounce": { "type": "number", "x-merge": "scalar" },
    "show_activities": { "type": "string", "enum": ["all", "none"], "x-merge": "scalar" },
    "proactive": { "type": "object", "x-merge": "dict" },
    "session_renew": {
      "type": "object",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "after_hours": { "type": "number", "exclusiveMinimum": 0, "default": 24 },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"], "default": "low" },
        "fallback_action": { "type": "string", "enum": ["continue", "new"], "default": "continue" }
      }
    },
    "group_venue_sync": { "type": "object", "x-merge": "dict" },
    "render": { "type": "object", "x-merge": "dict" },
    "sessionManifests": { "type": "object", "x-merge": "dict" },
    "enable_rich_content": { "type": "boolean", "x-merge": "scalar" },
    "permissionMode": {
      "type": "string",
      "enum": ["auto", "bypass", "readonly", "request", "edit", "plan", "noask"],
      "x-merge": "scalar"
    },
    "roles": {
      "type": "object",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "defaultRoles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "private": { "type": ["string", "null"], "pattern": "^[a-z0-9_-]+$" },
            "group": { "type": ["string", "null"], "pattern": "^[a-z0-9_-]+$" }
          }
        },
        "definitions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!owner$)(?!admin$)[a-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "permissions"],
            "properties": {
              "description": { "type": "string" },
              "allowAccess": { "type": "boolean" },
              "permissions": { "type": "object" },
              "commandPermissions": { "type": "object" },
              "usageLimits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "resetMode": { "type": "string", "enum": ["never", "daily", "weekly", "monthly"] },
                  "currency": { "type": "string", "enum": ["CNY", "USD"] },
                  "limitAmount": { "type": ["number", "null"], "minimum": 0 },
                  "costBasis": { "type": "string", "enum": ["gateway", "official"] },
                  "scope": { "type": "string", "enum": ["subject", "role"] }
                }
              }
            }
          }
        }
      }
    },
    "extra_backup": { "type": "array", "items": { "type": "object" }, "x-merge": "list" }
  }
}
