{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "behavior.schema.1.json",
  "title": "BehaviorConfig (behavior.json)",
  "description": "Agent-writable runtime behavior fields (HA).",
  "x-logical-name": "behavior",
  "x-permission": "HA",
  "x-scope": "behavior",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema_version": { "type": "number", "default": 1, "x-merge": "scalar" },
    "active_baseagent": {
      "type": "string",
      "description": "Active base agent for new sessions.",
      "x-merge": "scalar"
    },
    "baseagents": {
      "type": "object",
      "description": "Per-baseagent behavior such as model and reasoning effort.",
      "x-merge": "dict",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "model": { "type": "string" },
          "effort": { "type": "string" },
          "agentProgressSummaries": { "type": "boolean" },
          "excludeDynamicSections": { "type": "boolean" },
          "enableRequestUserInput": { "type": "boolean" },
          "approvalsReviewer": { "type": "string", "enum": ["user", "auto_review", "guardian_subagent"] },
          "mode": { "type": "string" },
          "useVertex": { "type": "boolean" }
        }
      }
    },
    "chatmode": {
      "type": "object",
      "description": "Chat mode by chat type.",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "private": { "type": "string", "enum": ["interactive", "proactive"] },
        "group": { "type": "string", "enum": ["interactive", "proactive"] },
        "nothuman": { "type": "string", "enum": ["interactive", "proactive"] }
      }
    },
    "flush_delay": { "type": "number", "x-merge": "scalar" },
    "debounce": { "type": "number", "x-merge": "scalar" },
    "dispatch": { "type": "string", "enum": ["all", "mention", "broadcast", "none"], "x-merge": "scalar" },
    "show_activities": { "type": "string", "enum": ["all", "none"], "x-merge": "scalar" },
    "proactive": {
      "type": "object",
      "description": "Fine-grained proactive-mode behavior.",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "pre_tool_1stmsgchk": { "type": "boolean" },
        "tool_use_reminder": { "type": "boolean" }
      }
    },
    "render": {
      "type": "object",
      "x-merge": "dict",
      "additionalProperties": false,
      "properties": {
        "private": { "type": "string" },
        "group": { "type": "string" },
        "inject": { "type": "string" }
      }
    },
    "enable_rich_content": { "type": "boolean", "x-merge": "scalar" },
    "permissionMode": { "type": "string", "x-merge": "scalar" },
    "roles": {
      "type": "object",
      "description": "Role-specific model/permission overrides.",
      "x-merge": "dict",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseagents": { "type": "object" },
          "permissionMode": { "type": "string" }
        }
      }
    }
  }
}
