{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roles.schema.4.json",
  "title": "RolesConfig",
  "description": "Global role definitions, field permissions, and command permissions",
  "x-logical-name": "roles",
  "x-permission": "H",
  "x-scope": "roles",
  "type": "object",
  "required": ["$schema_version", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema_version": {
      "type": "number",
      "const": 4,
      "description": "Schema version"
    },
    "defaultRoles": {
      "type": "object",
      "required": ["private", "group"],
      "additionalProperties": false,
      "description": "Default roles by conversation type",
      "properties": {
        "private": {
          "type": "string",
          "default": "anonymous",
          "description": "Fallback role for private conversations without explicit assignment"
        },
        "group": {
          "type": "string",
          "default": "guest",
          "description": "Fallback role for group members without explicit or inherited assignment"
        }
      }
    },
    "roles": {
      "type": "object",
      "description": "Role definitions keyed by role name",
      "additionalProperties": {
        "$ref": "#/definitions/RoleDefinition"
      }
    }
  },
  "definitions": {
    "RoleDefinition": {
      "type": "object",
      "required": ["description", "permissions"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable role description"
        },
        "allowAccess": {
          "type": "boolean",
          "default": true,
          "description": "Whether users with this role can access the agent"
        },
        "permissions": {
          "type": "object",
          "description": "Field-level permissions",
          "additionalProperties": {
            "$ref": "#/definitions/FieldPermission"
          }
        },
        "commandPermissions": {
          "type": "object",
          "description": "Command authorization rules keyed by operation, namespace wildcard, category, or wildcard",
          "additionalProperties": {
            "$ref": "#/definitions/CommandPermission"
          }
        }
      }
    },
    "FieldPermission": {
      "type": "object",
      "required": ["default", "allowOverride"],
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "Default value for this field"
        },
        "allowOverride": {
          "type": "boolean",
          "description": "Whether relation-level config can override this field"
        },
        "allowedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed model patterns for baseagents fields"
        },
        "allowedValues": {
          "type": "array",
          "description": "Allowed values for enum-like fields"
        },
        "reason": {
          "type": "string",
          "description": "Explanation for this permission setting"
        }
      }
    },
    "CommandPermission": {
      "type": "object",
      "required": ["allow"],
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "dangerous": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": ["relation", "role", "agent", "process", "filesystem", "control", "raw-cli"]
          }
        },
        "constraints": {
          "$ref": "#/definitions/CommandPermissionConstraints"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "CommandPermissionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownPeerOnly": {
          "type": "boolean"
        },
        "ownAgentOnly": {
          "type": "boolean"
        },
        "privateOnly": {
          "type": "boolean"
        },
        "groupOnly": {
          "type": "boolean"
        },
        "requireDaemonOwner": {
          "type": "boolean"
        },
        "requireControlChannel": {
          "type": "boolean"
        },
        "requireExplicitDangerousGrant": {
          "type": "boolean"
        },
        "requireFieldOverride": {
          "type": "string"
        },
        "allowedArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "deniedArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "forbiddenFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedConfigKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "outputLimitBytes": {
          "type": "integer",
          "minimum": 0
        },
        "cwdPolicy": {
          "enum": ["agentProject", "evolclawHome", "none"]
        },
        "envAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
